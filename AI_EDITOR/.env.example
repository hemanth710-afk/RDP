# AgentRouter / Anthropic Model Provider Configuration
MODEL_PROVIDER=agentrouter
MODEL_NAME=claude-opus-5
gemini_AUTH_TOKEN=YOUR_API_KEY_HERE
ANTHROPIC_BASE_URL=https://co.agentrouter.org
API_KEY_ENV_VAR=ANTHROPIC_AUTH_TOKEN
BASE_URL_ENV_VAR=ANTHROPIC_BASE_URL

# Application Paths (Optional overrides)
AI_EDITOR_AFTER_EFFECTS_2022_PATH=C:\Program Files\Adobe\Adobe After Effects 2022\Support Files\AfterFX.exe
AI_EDITOR_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
AI_EDITOR_CHROME_USER_DATA=C:\Users\User\AppData\Local\Google\Chrome\User Data
AI_EDITOR_CHROME_PROFILE=Default
